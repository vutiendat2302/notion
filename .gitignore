# ==============================================================================
# 1. BẢO MẬT & BIẾN MÔI TRƯỜNG (Security & Environment Variables)
# ==============================================================================
.env
.env.*
.env.local
!.env.example

# Tokens & Keys
*.token
*.key
*.pem
*.cert
output/validation.token

# ==============================================================================
# 2. PYTHON RUNTIME & BYTECODE
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / Build / Package
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ==============================================================================
# 3. IDE & CÔNG CỤ LẬP TRÌNH (Editors & IDEs)
# ==============================================================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/

# Sublime Text & Vim / Emacs
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.bak

# ==============================================================================
# 4. HỆ ĐIỀU HÀNH (Operating System Artifacts)
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory
.trash/

# ==============================================================================
# 5. DỰ ÁN NOTION: LOGS, ARCHIVE & HEAVY BACKUP (Project Specific)
# ==============================================================================
# Logs & nhật ký chạy runtime
*.log
logs/
*.log.*

# Thư mục lưu trữ cũ & scratch
archive/
scratch/
tmp/
.cache/

# File backup thô kích thước lớn từ Notion API (~6MB dữ liệu JSON gốc)
output/backup_raw_pages.json

# Ghi chú: Nếu repo là PUBLIC (công khai), hãy uncomment các dòng dưới đây
# để tránh lộ dữ liệu cá nhân (tên task, lịch trình, ghi chú) lên GitHub:
# input/*.csv
# !input/.gitkeep
# output/*.csv
# output/*.json
# !output/.gitkeep
