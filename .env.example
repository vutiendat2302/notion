# ==============================================================================
# Personal Productivity App — Shared Environment Example
# ==============================================================================
# Copy this file to `.env` for local development (`cp .env.example .env`).
# NEVER commit `.env` or real production secrets to Git.
# Replace all `CHANGE_ME_*` placeholders before deploying outside localhost.
# ==============================================================================

# --- Global Project & Runtime ---
COMPOSE_PROJECT_NAME=personal-productivity
APP_ENV=development
APP_DEBUG=true
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# --- Verified Container Image Pins ---
MYSQL_IMAGE=mysql:8.4
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
QDRANT_IMAGE=qdrant/qdrant:v1.13.4
OLLAMA_IMAGE=ollama/ollama:0.6.5

# --- MySQL 8.4 LTS (Single Instance, Logical DB Separation) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_MYSQL_ROOT_PASSWORD

# Primary Business Database (Backend owned ONLY)
MYSQL_DATABASE=productivity_db
MYSQL_USER=productivity_app
MYSQL_PASSWORD=CHANGE_ME_LOCAL_MYSQL_APP_PASSWORD

# Separate AI Metadata Database (AI Service owned ONLY - no access to productivity_db)
AI_MYSQL_DATABASE=ai_metadata_db
AI_MYSQL_USER=ai_metadata_app
AI_MYSQL_PASSWORD=CHANGE_ME_LOCAL_AI_MYSQL_PASSWORD

# --- Backend FastAPI (:8000, Python 3.14) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=mysql+asyncmy://productivity_app:CHANGE_ME_LOCAL_MYSQL_APP_PASSWORD@mysql:3306/productivity_db?charset=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30

# Auth & Security (generate >= 32 random chars for production)
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=CHANGE_ME_LOCAL_JWT_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Service-to-Service Auth (Backend <-> AI <-> OCR)
S2S_SIGNING_SECRET=CHANGE_ME_LOCAL_S2S_SECRET_AT_LEAST_32_CHARS
AI_ENABLED=false
AI_SERVICE_BASE_URL=http://ai-service:8001
AI_REQUEST_TIMEOUT_SECONDS=45

# --- Frontend Next.js 16 (:3000, Node 24) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# --- MinIO Self-Host Object Storage (Profile: storage / ai / full) ---
MINIO_ENDPOINT=minio:9000
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_SECURE=false
MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ADMIN_PASSWORD
MINIO_BUCKET_UPLOADS=personal-uploads
MINIO_BUCKET_ARTIFACTS=ai-artifacts
MINIO_BUCKET_EXPORTS=personal-exports

# --- Qdrant Vector Database (Profile: ai / full) ---
QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6343
QDRANT_GRPC_PORT=6344
QDRANT_COLLECTION=personal_knowledge_v1

# --- Ollama Local LLM Runtime (Profile: ai / full) ---
OLLAMA_PORT=11444
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- AI Service FastAPI (:8001, Python 3.14, Profile: ai / full) ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_DEFAULT_PROVIDER=local
AI_ALLOW_CLOUD=false
AI_LOG_PROMPT_CONTENT=false
AI_MAX_MODEL_REQUESTS=4
AI_MAX_TOOL_CALLS=8
AI_INGEST_MAX_PAGES=100
AI_INGEST_MAX_FILE_MB=25
AI_JOB_MAX_ATTEMPTS=3
AI_SERVICE_AUDIENCE=ai-service
BACKEND_TOOL_AUDIENCE=backend-tools
BACKEND_INTERNAL_BASE_URL=http://backend:8000
OCR_INTERNAL_URL=http://ocr-service:8866
AI_METADATA_DATABASE_URL=mysql+asyncmy://ai_metadata_app:CHANGE_ME_LOCAL_AI_MYSQL_PASSWORD@mysql:3306/ai_metadata_db?charset=utf8mb4
AI_CLOUD_PROVIDER=
AI_CLOUD_MODEL=
AI_CLOUD_API_KEY=

# --- OCR Service FastAPI (:8866, Python 3.12, Profile: ocr / ai / full) ---
OCR_SERVICE_HOST=0.0.0.0
OCR_SERVICE_PORT=8866
OCR_PROFILE=basic
OCR_DEFAULT_LANG=vi
OCR_MAX_PIXELS=25000000
OCR_MAX_PAGES=100
OCR_MAX_INPUT_MB=25
OCR_WORKERS=1
OCR_ENABLE_LAYOUT=false
OCR_ENABLE_TABLE=false
OCR_TIMEOUT_SECONDS=120
