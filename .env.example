# Token tích hợp từ Notion (Internal Integration Secret)
# Lấy tại: https://www.notion.so/my-integrations
# Định dạng thường bắt đầu bằng: ntn_... hoặc secret_...
NOTION_TOKEN=ntn_your_notion_secret_token_here

# Database ID của Notion Database cần thao tác
# Lấy từ URL của database: https://www.notion.so/{workspace_name}/{database_id}?v=...
# database_id là chuỗi 32 ký tự chữ và số (ví dụ: a1b2c3d4e5f6...)
NOTION_DATABASE_ID=your_32_char_database_id_here

# Tùy chọn: Tên các cột/thuộc tính trong Notion (để trống script sẽ tự nhận diện thông minh)
PROP_TITLE=
PROP_STATUS=
PROP_DATE=
